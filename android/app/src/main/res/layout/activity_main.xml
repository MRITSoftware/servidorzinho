<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MRIT Server Local"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Verificando instalação..."
        android:textSize="16sp"
        android:gravity="center"
        android:padding="16dp"
        android:background="#f0f0f0"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/installButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Instalar"
        android:textSize="18sp"
        android:padding="16dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/openTermuxButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📱 Abrir Termux"
        android:textSize="16sp"
        android:padding="12dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📋 Comandos Úteis (Copiar e Colar no Termux):"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/copyInstallButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📥 1. Instalar Dependências"
        android:textSize="15sp"
        android:padding="14dp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/copyStartButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="▶ 2. Iniciar Servidor"
        android:textSize="15sp"
        android:padding="14dp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/copyStatusButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📊 3. Verificar Status"
        android:textSize="15sp"
        android:padding="14dp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/copyLogsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📋 4. Ver Logs"
        android:textSize="15sp"
        android:padding="14dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="© MRIT"
        android:textSize="12sp"
        android:gravity="center"
        android:textColor="#888888"
        android:layout_marginTop="16dp" />

</LinearLayout>

